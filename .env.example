# Public base URL of the deployed site (canonical URLs, sitemap, OG, JSON-LD, robots.txt).
# Read at build time from .env or the shell; `npm run deploy` refuses placeholder values.
PUBLIC_SITE_URL=http://localhost:4334
# Optional: same-origin path the quote form POSTs JSON to (e.g. /api/quote on a Worker route).
# Empty = demo mode (nothing is sent). Cross-origin URLs are rejected at build time (CSP).
PUBLIC_FORM_ENDPOINT=
