{
  "name": "first-mountain",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4334",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "images:prepare": "node scripts/prepare-images.mjs",
    "build:prune": "npm run build && node scripts/prune-dist.mjs",
    "deploy": "node scripts/check-site-url.mjs && npm run build && node scripts/prune-dist.mjs && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  },
  "private": true
}
