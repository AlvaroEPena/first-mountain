---
import { cityLine } from '../../lib/address';
/**
 * Click-to-load map. An on-brand placeholder (topo contours, ridgeline, pin) holds the space;
 * Google's embed loads only after "Show map", so no Google request or cookie happens before the
 * visitor asks. "Get directions" always works, with or without the map.
 */
import { RIDGE_VIEWBOX, ridgeLine } from '../../assets/brand/geometry.mjs';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<div
  class="map"
  data-map
  data-src={site.links.mapEmbed}
  data-title={`Map showing ${site.name}, ${site.address.street}, ${site.address.city}`}
>
  <div class="map__frame" data-map-frame>
    <div class="map__placeholder" data-map-placeholder>
      <svg class="map__ridge" viewBox={RIDGE_VIEWBOX} preserveAspectRatio="none" aria-hidden="true">
        <path
          d={ridgeLine()}
          fill="none"
          stroke="var(--color-wet)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
      <div class="map__pin" aria-hidden="true">
        <Icon name="pin" />
      </div>
      <p class="map__address">
        <strong>{site.address.street}</strong>
        <span>{cityLine(site.address)}</span>
      </p>
      <button type="button" class="btn btn-primary btn-compact" data-map-load>
        <Icon name="map" />
        Show map
      </button>
      <p class="map__note">Loads Google Maps</p>
    </div>
  </div>
  <a class="arrow-link map__directions" href={site.links.directions} target="_blank" rel="noopener">
    <Icon name="directions" />
    <span>Get directions</span>
    <span class="visually-hidden"> (opens Google Maps in a new tab)</span>
  </a>
</div>

<style>
  .map {
    display: grid;
    gap: 0.5rem;
  }
  .map__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-slab);
    border: var(--joint);
    background-color: var(--color-cured);
    background-image: url('../../assets/brand/topo-on-light.svg');
    background-size: 180% auto;
    background-position: 40% 50%;
  }
  .map__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }
  .map__ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12%;
    width: 100%;
    height: 22%;
    opacity: 0.6;
  }
  .map__pin {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-slab);
    background: var(--color-granite);
    color: var(--color-alpenglow-lit);
  }
  .map__pin :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .map__address {
    position: relative;
    display: grid;
    line-height: 1.4;
  }
  .map__note {
    position: relative;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }
  .map__directions {
    justify-self: start;
  }
</style>

<script>
  /** Swap the placeholder for Google's embed on request, then move focus to the map. */
  for (const map of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const button = map.querySelector<HTMLButtonElement>('[data-map-load]');
    const frame = map.querySelector<HTMLElement>('[data-map-frame]');
    const src = map.dataset.src;
    const title = map.dataset.title ?? 'Map';
    if (!button || !frame || !src) continue;
    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = title;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.setAttribute('allowfullscreen', '');
        map.querySelector('[data-map-placeholder]')?.remove();
        frame.append(iframe);
        iframe.focus();
      },
      { once: true },
    );
  }
</script>
