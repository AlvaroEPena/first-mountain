---
import { reviews } from '../../data/reviews';
import RatingSummary from '../reviews/RatingSummary.astro';
import Icon from '../ui/Icon.astro';
import Screed from '../ui/Screed.astro';

/** Pull quotes only (each a verbatim slice of a full review on /reviews). */
const highlights = reviews.filter((review) => review.highlight);
---

<section class="section track-section" aria-labelledby="reviews-title">
  <div class="shell track__head">
    <div class="track__intro">
      <Screed>
        <h2 id="reviews-title" class="text-h2">
          What customers say
        </h2>
      </Screed>
      <RatingSummary />
    </div>
    <a class="arrow-link" href="/reviews">
      <span>Read every review</span>
      <Icon name="arrow" />
    </a>
  </div>

  <!-- One marquee on the page. It keeps moving under the mouse; the button pauses it (WCAG
       2.2.2) and turns it into a sideways scroller (swipe, or the mouse wheel over it), and it
       also holds still while a keyboard user is focused inside it. Under reduced motion it is
       a plain scroller from the start. -->
  <div class="track" data-track>
    <div class="track__viewport" tabindex="0" role="region" aria-label="Customer quotes">
      <div class="track__rail">
        {[0, 1].map((copy) => (
          <ul class="track__list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {highlights.map((review) => (
              <li class="track__card">
                <blockquote>
                  <p>&ldquo;{review.highlight}&rdquo;</p>
                  <footer>{review.displayName}</footer>
                </blockquote>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
    <div class="shell track__controls">
      <p class="track__hint" data-track-hint hidden>
        Swipe or scroll to browse
      </p>
      <button type="button" class="chip" data-track-toggle aria-pressed="false">
        Pause quotes
      </button>
    </div>
  </div>
</section>

<style>
  .track-section {
    border-top: var(--joint);
  }
  .track__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: 2.5rem;
  }
  .track__intro {
    display: grid;
    gap: 1.25rem;
  }
  .track {
    position: relative;
  }
  .track__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1rem;
  }
  .track__hint {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .track__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track__viewport:focus-visible {
    outline-offset: -3px;
  }
  .track__rail {
    display: flex;
    width: max-content;
    animation: marquee 90s linear infinite;
  }
  /* Keyboard focus holds it still (mouse clicks and hover do not). */
  .track:has(:focus-visible) .track__rail {
    animation-play-state: paused;
  }
  /* Paused with the button: the script converts the animation offset into scrollLeft. */
  .track[data-paused] .track__rail {
    animation: none;
  }
  .track[data-paused] .track__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .track__list {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0 0.75rem 0 0;
    list-style: none;
  }
  .track__card {
    display: flex;
    width: min(78vw, 24rem);
    padding: 1.5rem;
    border-radius: var(--radius-slab);
    background: var(--color-cured);
    border: var(--joint);
  }
  .track__card:nth-child(3n + 2) {
    background: var(--color-granite);
    color: var(--color-on-dark);
  }
  blockquote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }
  blockquote p {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  blockquote footer {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .track__card:nth-child(3n + 2) footer {
    color: var(--color-on-dark-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .track__controls,
    .track__list[aria-hidden='true'] {
      display: none;
    }
    .track__rail {
      animation: none;
    }
    .track__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      mask-image: none;
    }
    .track__list {
      padding-inline: var(--gutter);
    }
    .track__card {
      scroll-snap-align: start;
    }
  }
</style>

<script>
  import { cssTimeToSeconds, offsetToDelay, wheelToScrollLeft } from '../../lib/marquee';

  // Pause turns the marquee into a scroller at the exact spot it stopped; Play resumes the
  // animation from wherever the visitor scrolled to. State lives on the wrapper as data-paused.
  for (const track of document.querySelectorAll<HTMLElement>('[data-track]')) {
    const toggle = track.querySelector<HTMLButtonElement>('[data-track-toggle]');
    const hint = track.querySelector<HTMLElement>('[data-track-hint]');
    const viewport = track.querySelector<HTMLElement>('.track__viewport');
    const rail = track.querySelector<HTMLElement>('.track__rail');
    if (!toggle || !viewport || !rail) continue;

    const duration = cssTimeToSeconds(getComputedStyle(rail).animationDuration);
    const loopWidth = () => rail.scrollWidth / 2; // two identical copies of the list

    const pause = () => {
      const offset = -new DOMMatrixReadOnly(getComputedStyle(rail).transform).m41;
      track.setAttribute('data-paused', '');
      viewport.scrollLeft = offset;
    };

    const play = () => {
      const delay = offsetToDelay(viewport.scrollLeft, loopWidth(), duration);
      rail.style.animationDelay = `${delay}s`;
      track.removeAttribute('data-paused');
      viewport.scrollLeft = 0;
    };

    toggle.addEventListener('click', () => {
      const willPause = !track.hasAttribute('data-paused');
      if (willPause) pause();
      else play();
      toggle.textContent = willPause ? 'Play quotes' : 'Pause quotes';
      toggle.setAttribute('aria-pressed', String(willPause));
      if (hint) hint.hidden = !willPause;
    });

    // Mouse wheel over the paused scroller moves it sideways; at either end the page scrolls.
    viewport.addEventListener(
      'wheel',
      (event) => {
        if (!track.hasAttribute('data-paused')) return;
        const next = wheelToScrollLeft(
          event.deltaX,
          event.deltaY,
          viewport.scrollLeft,
          viewport.scrollWidth - viewport.clientWidth,
        );
        if (next === null) return;
        event.preventDefault();
        viewport.scrollLeft = next;
      },
      { passive: false },
    );
  }
</script>
