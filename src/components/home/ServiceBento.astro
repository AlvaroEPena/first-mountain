---
import { serviceEvidence, services, type Service } from '../../data/services';
import { site } from '../../data/site';
import type { ServiceId } from '../../data/service-ids';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';

/**
 * Eight services, eight cells. Six carry a real project photo; RV pads and fences have no honest
 * photo in the gallery, so they get a distinct surface (granite with topo, wide cured with the
 * featured customer quote) instead of a fake image.
 */
interface Cell {
  id: ServiceId;
  area: string;
  look: 'photo' | 'granite' | 'plain';
  photo?: string;
  /** Rendered width class, for an accurate responsive sizes attribute. */
  span?: 'wide' | 'narrow';
  /** Spans two rows on wide screens: square crop and larger sizes, so it stays sharp. */
  tall?: boolean;
  /** Wide text-only cells carry the service's featured customer quote. */
  showQuote?: boolean;
}

const cells: Cell[] = [
  { id: 'driveways', area: 'drive', look: 'photo', photo: 'photo-28', span: 'wide' },
  { id: 'sport-courts', area: 'court', look: 'photo', photo: 'photo-03', span: 'wide' },
  { id: 'patios-pads', area: 'patio', look: 'photo', photo: 'photo-43', span: 'narrow' },
  {
    id: 'retaining-walls',
    area: 'wall',
    look: 'photo',
    photo: 'photo-25',
    span: 'narrow',
    tall: true,
  },
  { id: 'steps-walkways', area: 'steps', look: 'photo', photo: 'photo-07', span: 'narrow' },
  { id: 'hardscape', area: 'hard', look: 'photo', photo: 'photo-19', span: 'wide' },
  { id: 'rv-pads', area: 'rv', look: 'granite' },
  { id: 'fences', area: 'fence', look: 'plain', showQuote: true },
];

/** Phones: one column inside the gutters. Tablets: half or full width. Desktop: 1 or 2 of 4. */
const SIZES = {
  wide: '(min-width: 64rem) min(44vw, 42rem), (min-width: 48rem) 46vw, calc(100vw - 2rem)',
  narrow: '(min-width: 64rem) min(22vw, 21rem), (min-width: 48rem) 46vw, calc(100vw - 2rem)',
  // A square crop filling a tile two rows tall needs about one and a half times its width.
  tall: '(min-width: 64rem) min(34vw, 32rem), (min-width: 48rem) 46vw, calc(100vw - 2rem)',
} as const;

const byId = (id: ServiceId): Service => {
  const service = services.find((entry) => entry.id === id);
  if (!service) throw new Error(`Unknown service ${id}`);
  return service;
};
---

<section class="section" aria-labelledby="services-title">
  <div class="shell">
    <header class="bento__head">
      <h2 id="services-title" class="text-h2">
        What we pour
      </h2>
      <p class="lead" data-reveal>
        Flatwork, walls and the hardscape around them, for homes in {site.serviceArea}.
      </p>
    </header>

    <ul class="bento">
      {cells.map((cell) => {
        const service = byId(cell.id);
        return (
          <li
            class={`bento__cell bento__cell--${cell.look}`}
            data-area={cell.area}
            style={`grid-area: ${cell.area}`}
          >
            <a href={`/services#${service.id}`} class="bento__link">
              {cell.photo && (
                <span class="bento__media" aria-hidden="true">
                  <Photo
                    id={cell.photo}
                    alt=""
                    widths={[360, 540, 720, 960, 1280]}
                    sizes={cell.tall ? SIZES.tall : SIZES[cell.span ?? 'narrow']}
                    aspect={cell.tall ? 1 : 3 / 2}
                  />
                </span>
              )}
              <span class="bento__text">
                {cell.showQuote && (
                  <span class="bento__quote" aria-hidden="true">
                    &ldquo;{serviceEvidence(service).featured.highlight}&rdquo;
                  </span>
                )}
                <span class="bento__name">{service.name}</span>
                <span class="bento__summary">{service.bullets[0]}</span>
              </span>
              <Icon name="arrow" class="bento__arrow" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .bento__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .bento {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-areas: 'drive' 'court' 'patio' 'wall' 'steps' 'hard' 'rv' 'fence';
  }
  /* The link flows inside the cell, so a tile grows to fit its text instead of clipping it. */
  .bento__cell {
    position: relative;
    display: flex;
    overflow: hidden;
    min-height: 9rem;
    border-radius: var(--radius-slab);
  }
  .bento__cell--photo {
    min-height: 15rem;
    background: var(--color-slate);
    color: var(--color-on-dark);
  }
  .bento__cell--granite {
    background-color: var(--color-granite);
    background-image: url('../../assets/brand/topo-on-dark.svg');
    background-size: 220% auto;
    background-position: 70% 30%;
    color: var(--color-on-dark);
  }
  .bento__cell--plain {
    background: var(--color-cured);
    border: var(--joint);
  }
  .bento__link {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
  }
  .bento__link:focus-visible {
    outline-offset: -4px;
  }
  .bento__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bento__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .bento__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(23 28 31 / 0.85), rgb(23 28 31 / 0.1) 60%);
  }
  .bento__link:hover .bento__media :global(img),
  .bento__link:focus-visible .bento__media :global(img) {
    transform: scale(1.04);
  }
  .bento__text {
    position: relative;
    display: grid;
    gap: 0.3rem;
  }
  .bento__name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .bento__quote {
    max-width: 34ch;
    margin-bottom: 0.75rem;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }
  .bento__summary {
    font-size: var(--text-small);
    opacity: 0.85;
  }
  .bento__cell :global(.bento__arrow) {
    position: relative;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    border-radius: var(--radius-slab);
    background: var(--color-alpenglow);
    color: var(--color-granite);
    transition: transform 0.35s var(--ease-out);
  }
  .bento__link:hover :global(.bento__arrow) {
    transform: translateX(4px);
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(12rem, auto);
      grid-template-areas:
        'drive drive'
        'court patio'
        'wall steps'
        'wall hard'
        'rv fence';
    }
    .bento__cell--photo {
      min-height: 0;
    }
    .bento__cell[data-area='drive'] {
      min-height: 22rem;
    }
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(13.5rem, 1fr);
      grid-template-areas:
        'drive drive court court'
        'drive drive patio wall'
        'steps hard hard wall'
        'rv fence fence fence';
    }
    .bento__cell[data-area='drive'] {
      min-height: 0;
    }
  }
</style>
