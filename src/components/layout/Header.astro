---
import { estimateCta, isCurrentPath, primaryNav } from '../../lib/content/navigation';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  /** "overlay" starts transparent over a dark hero photo (Home); "solid" starts on chalk. */
  mode?: 'overlay' | 'solid';
}

const { mode = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="site-header" data-site-header data-mode={mode}>
  <div class="site-header__bar shell">
    <a href="/" class="site-header__logo" aria-label={`${site.name}, home`}>
      <Logo tone="onDark" class="logo logo--dark" />
      <Logo tone="onLight" class="logo logo--light" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrentPath(pathname, link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={site.phoneHref}>
        <Icon name="phone" />
        <span class="site-header__phone-number">{site.phone}</span>
        <span class="visually-hidden site-header__phone-label">Call {site.phone}</span>
      </a>
      <a class="btn btn-primary btn-compact site-header__cta" href={estimateCta.href} data-magnetic>
        {estimateCta.label}
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--layer-header);
    color: var(--color-ink);
    view-transition-name: site-header;
    transition:
      background-color 0.3s,
      box-shadow 0.3s,
      color 0.3s;
  }
  .site-header[data-mode='solid'],
  .site-header[data-scrolled],
  :global(html[data-menu-open]) .site-header {
    background: rgb(242 242 239 / 0.92);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    box-shadow: inset 0 -1px 0 rgb(23 28 31 / 0.12);
  }
  .site-header[data-mode='overlay']:not([data-scrolled]) {
    color: var(--color-on-dark);
  }
  /* Keeps the overlay header legible over the brightest sky in the photo. */
  .site-header[data-mode='overlay']::before {
    content: '';
    position: absolute;
    inset: 0 0 -2.5rem;
    z-index: -1;
    background: linear-gradient(180deg, rgb(23 28 31 / 0.6), transparent);
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .site-header[data-scrolled]::before,
  :global(html[data-menu-open]) .site-header::before {
    opacity: 0;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: var(--header-h);
  }
  .site-header__logo {
    display: inline-flex;
    flex-shrink: 1;
    min-width: 0;
    padding-block: 0.5rem;
  }
  .site-header__logo :global(.logo) {
    height: 2.125rem;
    width: auto;
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out);
  }
  /* Condense on scroll with a transform only, so nothing below shifts. */
  .site-header[data-scrolled] .site-header__logo :global(.logo) {
    transform: scale(0.88);
  }
  .site-header__logo :global(.logo--dark) {
    display: none;
  }
  .site-header[data-mode='overlay']:not([data-scrolled]) .site-header__logo :global(.logo--dark) {
    display: block;
  }
  .site-header[data-mode='overlay']:not([data-scrolled]) .site-header__logo :global(.logo--light) {
    display: none;
  }
  :global(html[data-menu-open]) .site-header .site-header__logo :global(.logo--dark) {
    display: none;
  }
  :global(html[data-menu-open]) .site-header .site-header__logo :global(.logo--light) {
    display: block;
  }
  :global(html[data-menu-open]) .site-header {
    color: var(--color-ink);
  }

  .site-header__nav {
    display: none;
  }
  .site-header__nav ul {
    display: flex;
    gap: clamp(1.25rem, 0.2rem + 1.6vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.75rem;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
  }
  /* Active and hover state: a control-joint underline cut in from the left. */
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 2px;
    background: var(--color-alpenglow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__phone :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .site-header__phone-number {
    display: none;
  }
  .site-header__cta {
    display: none;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-slab);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .menu-toggle__bars {
    transform: translateY(-3px);
  }
  .menu-toggle__bars::before {
    content: '';
    transform: translateY(6px);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: rotate(-90deg);
  }

  @media (min-width: 30rem) {
    .site-header__logo :global(.logo) {
      height: 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
    .site-header__actions {
      gap: 1rem;
    }
  }

  @media (min-width: 80rem) {
    .site-header__phone-number {
      display: inline;
    }
    .site-header__phone-label {
      display: none;
    }
  }
</style>
