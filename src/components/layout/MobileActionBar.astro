---
import { estimateCta } from '../../lib/content/navigation';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<!-- Thumb-reach actions on phones: the three ways people actually hire a contractor. -->
<nav class="action-bar on-dark" aria-label="Quick contact">
  <a href={site.phoneHref} class="action-bar__item">
    <Icon name="phone" />
    <span>Call</span>
  </a>
  <a href={site.smsHref} class="action-bar__item">
    <Icon name="message" />
    <span>Text</span>
  </a>
  <a href={estimateCta.href} class="action-bar__item action-bar__item--primary">
    <Icon name="clipboard" />
    <span>Estimate</span>
  </a>
</nav>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--layer-action-bar);
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 1px;
    padding-bottom: env(safe-area-inset-bottom);
    background: rgb(242 242 239 / 0.14);
    box-shadow: 0 -10px 30px -12px rgb(23 28 31 / 0.5);
    view-transition-name: action-bar;
  }
  .action-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--action-bar-h);
    background: var(--color-granite);
    color: var(--color-on-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .action-bar__item :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .action-bar__item--primary {
    background: var(--color-alpenglow);
    color: var(--color-granite);
  }
  .action-bar__item:active {
    transform: translateY(1px);
  }
  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>
