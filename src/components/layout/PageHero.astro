---
import type { Crumb } from '../../lib/seo';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: readonly Crumb[];
}

const { title, lead, crumbs } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', { 'page-hero--split': hasAside }]} aria-labelledby="page-title">
  <div class="shell page-hero__grid">
    <div class="page-hero__copy">
      <Breadcrumbs crumbs={crumbs} />
      <div class="screed screed--load">
        <h1 id="page-title" class="page-hero__title">
          {title}
        </h1>
        <span class="screed__board" aria-hidden="true"></span>
      </div>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {hasAside && (
      <div class="page-hero__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: var(--joint);
    background-color: var(--color-chalk);
    background-image: url('../../assets/brand/topo-on-light.svg');
    background-size: 160% auto;
    background-position: 85% 30%;
    background-repeat: no-repeat;
  }
  .page-hero__grid {
    display: grid;
    gap: 2.5rem;
  }
  .page-hero__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .page-hero__title {
    max-width: 20ch;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
  }
  @media (min-width: 64rem) {
    .page-hero--split .page-hero__grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
      align-items: end;
    }
  }
</style>
