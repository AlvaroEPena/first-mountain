---
/**
 * The Wasatch ridgeline as the top edge of the closing granite block, with a thin alpenglow
 * line on the crest: the last light on the peaks, where the page ends.
 */
import { RIDGE_VIEWBOX, ridgeLine, ridgeSilhouette } from '../../assets/brand/geometry.mjs';
---

<div class="ridge" aria-hidden="true">
  <svg viewBox={RIDGE_VIEWBOX} preserveAspectRatio="none" focusable="false">
    <path d={ridgeSilhouette()} fill="var(--color-granite)"></path>
    <path
      d={ridgeLine()}
      fill="none"
      stroke="var(--color-alpenglow)"
      stroke-width="2"
      vector-effect="non-scaling-stroke"
      data-ridge-line
    ></path>
  </svg>
</div>

<style>
  .ridge {
    position: relative;
    height: clamp(3.5rem, 2rem + 6vw, 8rem);
    margin-bottom: -1px;
    pointer-events: none;
  }
  .ridge svg {
    width: 100%;
    height: 100%;
  }
</style>
