---
import { site } from '../../data/site';
import { monthYear } from '../../lib/rating';
import Stars from '../ui/Stars.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { value, count, capturedOn } = site.rating;
---

<a
  class:list={['google-badge', className]}
  href={site.links.googleReviews}
  target="_blank"
  rel="noopener"
>
  <!-- The stars label announces the rating; the big figure is visual only, so it is read once. -->
  <span class="google-badge__value" aria-hidden="true">
    {value.toFixed(1)}
  </span>
  <span class="google-badge__detail">
    <Stars rating={value} label={`Rated ${value.toFixed(1)} out of 5`} />
    <span>
      from {count} Google reviews, as of {monthYear(capturedOn)}
      <span class="visually-hidden"> (opens Google Maps in a new tab)</span>
    </span>
  </span>
</a>

<style>
  .google-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem 0.4rem 0.4rem;
    border: 1px solid rgb(242 242 239 / 0.28);
    border-radius: var(--radius-slab);
    background: rgb(23 28 31 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-on-dark);
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .google-badge:hover {
    border-color: rgb(242 242 239 / 0.6);
  }
  .google-badge__value {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.5rem;
    padding-inline: 0.4rem;
    border-radius: var(--radius-field);
    background: var(--color-chalk);
    color: var(--color-granite);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
  }
  .google-badge__detail {
    display: grid;
    gap: 0.15rem;
  }
  .google-badge :global(.stars) {
    color: var(--color-pine-lit);
  }
  .google-badge :global(.stars svg) {
    width: 0.875rem;
    height: 0.875rem;
  }
</style>
