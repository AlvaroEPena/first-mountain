---
import { ownerFirstName } from '../../lib/owner';
import type { Review } from '../../data/reviews';
import Stars from '../ui/Stars.astro';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const paragraphs = review.text.split(/\n\s*\n/);
const titleId = `review-${review.id}`;
---

<article class="review" aria-labelledby={titleId}>
  <header class="review__head">
    <Stars rating={review.rating} />
    <span class="review__year">{review.approxYear}</span>
  </header>
  {review.highlight && <p class="review__highlight">&ldquo;{review.highlight}&rdquo;</p>}
  <div class="review__text">
    {paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <footer class="review__by">
    <h3 id={titleId} class="review__name">
      {review.displayName}
    </h3>
    <p class="review__meta">
      {review.attribution ? `${review.attribution}, ` : ''}
      {review.localGuide ? 'Google Local Guide' : 'Google review'}
    </p>
  </footer>
  {review.ownerReply && (
    <div class="review__reply">
      <p class="review__reply-label">Reply from {ownerFirstName}</p>
      <p>{review.ownerReply}</p>
    </div>
  )}
</article>

<style>
  .review {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-slab);
    background: var(--color-chalk);
    border: var(--joint);
    break-inside: avoid;
  }
  .review__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .review__year {
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }
  .review__highlight {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .review__text {
    display: grid;
    gap: 0.75rem;
    font-size: 0.975rem;
    color: var(--color-ink-muted);
  }
  .review__by {
    padding-top: 0.85rem;
    border-top: var(--joint);
  }
  .review__name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .review__meta {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .review__reply {
    padding: 0.85rem 1rem;
    border-left: 2px solid var(--color-alpenglow);
    background: var(--color-cured);
    font-size: 0.9375rem;
  }
  .review__reply-label {
    font-weight: 700;
  }
</style>
