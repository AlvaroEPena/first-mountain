---
import { faqs } from '../../lib/content/faq';
import Screed from '../ui/Screed.astro';
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="shell faq__grid">
    <Screed>
      <h2 id="faq-title" class="text-h2">
        Questions people ask before they call
      </h2>
    </Screed>
    <div class="faq__list">
      {faqs.map((faq) => (
        <details class="faq__item">
          <summary>
            <span>{faq.question}</span>
            <span class="faq__mark" aria-hidden="true" />
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    border-top: var(--joint);
  }
  .faq__grid {
    display: grid;
    gap: 2rem;
  }
  .faq__grid h2 {
    max-width: 14ch;
  }
  .faq__list {
    border-top: var(--joint);
  }
  .faq__item {
    border-bottom: var(--joint);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding-block: 1rem;
    font-weight: 700;
    font-size: 1.125rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Plus that turns into a minus: two saw cuts crossing. */
  .faq__mark {
    position: relative;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-alpenglow-ink);
    transition: transform 0.3s var(--ease-out);
  }
  .faq__mark::after {
    transform: rotate(90deg);
  }
  details[open] .faq__mark::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 62ch;
    padding-bottom: 1.25rem;
    color: var(--color-ink-muted);
  }
  @media (min-width: 64rem) {
    .faq__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
    }
  }
</style>
