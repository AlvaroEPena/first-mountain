---
/**
 * Screed reveal wrapper. A board the colour of the surrounding surface covers the content and
 * sweeps off to the right when it scrolls into view (motion module). Without JS, or with
 * reduced motion, the board never covers anything.
 */
interface Props {
  /** Surface colour behind the content, so the board blends in. */
  surface?: 'chalk' | 'cured' | 'granite';
  /** Wrapper element. */
  as?: 'div' | 'span';
  class?: string;
}

const { surface = 'chalk', as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={['screed', className]}
  data-screed
  style={`--screed-color: var(--color-${surface})`}
>
  <slot />
  <span class="screed__board" aria-hidden="true"></span>
</Tag>
