---
import Icon from '../components/ui/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateCta } from '../lib/content/navigation';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Head back to the home page, see our project photos or get a free estimate."
>
  <section class="section lost topo-light" aria-labelledby="lost-title">
    <div class="shell lost__inner">
      <p class="lost__code" aria-hidden="true">
        404
      </p>
      <h1 id="lost-title" class="text-h1">
        Nothing poured here yet.
      </h1>
      <p class="lead">
        The page you were looking for is not on this site. It may have moved when we rebuilt it.
      </p>
      <div class="lost__actions">
        <a class="btn btn-primary" href="/">
          Back to the home page
          <Icon name="arrow" />
        </a>
        <a class="btn btn-outline" href="/projects">
          See project photos
        </a>
        <a class="btn btn-outline" href={estimateCta.href}>
          {estimateCta.label}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 60svh;
    display: grid;
    align-items: center;
  }
  .lost__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lost__code {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-aggregate);
  }
  .lost h1 {
    max-width: 14ch;
  }
  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
